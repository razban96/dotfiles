// Place your key bindings in this file to override the defaults
[
  {
    "key": "f5",
    "command": "cmake.debugTarget",
    "when": "inCMakeProject",
  },
  {
    "key": "ctrl+f5",
    "command": "cmake.launchTarget",
    "when": "inCMakeProject",
  },
  {
    "key": "ctrl+shift+f5",
    "command": "cmake.build",
    "when": "inCMakeProject",
  },
  {
    "key": "ctrl+shift+w",
    "command": "-workbench.action.closeWindow",
  },
]
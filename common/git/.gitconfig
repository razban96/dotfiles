[user]
    name = Chiurtu Andrei Razvan
    email = razvan14chiurtu@gmail.com

[init]
    defaultBranch = main

[core]
	autocrlf = true
    safecrlf = warn
    editor = clion --wait
    longpaths = true
    fscache = true
    preloadindex = true
    fsmonitor = true
    untrackedCache = true
    filemode = false
    excludesfile = ~/.gitignore_global
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[pull]
    rebase = true

[rebase]
    autoStash = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[push]
    autoSetupRemote = true
    default = simple

[fetch]
    prune = true
    pruneTags = true

[diff]
    algorithm = histogram
    colorWords = true
    renames = true
    tool = clion

[difftool "clion"]
    cmd = clion diff "$LOCAL" "$REMOTE"
    prompt = false

[column]
    ui = auto

[branch]
    sort = -committerdate

[alias]
    st = status -sb
    co = checkout
    br = branch
    cm = commit -m
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    unstage = reset HEAD --
    last = log -1 HEAD
